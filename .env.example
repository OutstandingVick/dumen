# Copy to .env and fill in. Never commit .env.

# Meterless Nightshift (OpenAI-compatible, local)
NIGHTSHIFT_BASE_URL=http://127.0.0.1:8088/v1
NIGHTSHIFT_API_KEY=your-nightshift-token
NIGHTSHIFT_MODEL=nvidia/your-nemotron-model-id
NIGHTSHIFT_TIMEOUT_MS=60000

# Zetaris (local Docker install)
ZETARIS_URL=http://localhost:3001
ZETARIS_USER=your-zetaris-email
ZETARIS_PASSWORD=your-zetaris-password

# Orders DB (source A)
DATABASE_URL=postgres://dumen:dumen@localhost:5433/orders

# true = canned LLM responses, no API calls
SAMPLE_MODE=true

# Processor log (source B)
PROCESSOR_DATABASE_URL=postgres://dumen:dumen@localhost:5434/processor
